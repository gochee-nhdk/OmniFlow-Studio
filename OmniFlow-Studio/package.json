{
  "name": "fm-auto-ops",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test && npm run test:unit",
    "test:unit": "node --test tests/unit/core.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:stress": "node --test tests/stress/*.test.mjs",
    "test:challenge": "node --test tests/e2e/diagnostics/*.test.mjs",
    "test:all": "turbo test && npm run test:unit && npm run test:e2e && npm run test:stress && npm run test:challenge",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "agent:dev": "pnpm --filter @fm/local-agent dev",
    "agent:build": "pnpm --filter @fm/local-agent build",
    "web:dev": "pnpm --filter @fm/web dev",
    "setup": "node scripts/setup.mjs",
    "tools:setup": "node scripts/setup-tools.mjs",
    "ecc": "node tools/ecc/scripts/ecc.js",
    "ecc:status": "node tools/ecc/scripts/ecc.js status",
    "ecc:doctor": "node tools/ecc/scripts/ecc.js doctor",
    "ecc:catalog": "node tools/ecc/scripts/ecc.js catalog",
    "graphify": "uv run --project tools/graphify graphify",
    "graphify:update": "uv run --project tools/graphify graphify update .",
    "graphify:query": "uv run --project tools/graphify graphify query",
    "graphify:export": "uv run --project tools/graphify graphify export html",
    "spec-kit": "uv run --project tools/spec-kit specify",
    "spec-kit:check": "uv run --project tools/spec-kit specify check",
    "specify": "uv run --project tools/spec-kit specify",
    "ponytail": "node scripts/tools-runner.mjs ponytail",
    "ponytail:audit": "node scripts/tools-runner.mjs ponytail-audit",
    "ponytail:review": "node scripts/tools-runner.mjs ponytail-review"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
