{
    "name":  "@fm/local-agent",
    "productName":  "OmniFlow Studio",
    "version":  "1.0.0",
    "description":  "OmniFlow Studio — Enterprise ERP & POS Automation Platform",
    "author":  "OmniFlow Studio",
    "private":  true,
    "type":  "commonjs",
    "main":  "dist/main/index.js",
    "scripts":  {
                    "dev":  "electron src/main/index.ts",
                    "build":  "tsc",
                    "build:installer":  "npm run build && electron-builder",
                    "typecheck":  "tsc --noEmit",
                    "test":  "node --test",
                    "start":  "electron dist/main/index.js"
                },
    "build":  {
                  "appId":  "com.omniflow.studio",
                  "productName":  "OmniFlow Studio",
                  "directories":  {
                                      "output":  "../../release"
                                  },
                  "artifactName": "OmniFlow-Studio-v${version}-windows-x64.${ext}",
                  "files":  [
                                "dist/**/*",
                                "package.json",
                                "!node_modules/**/src/**/*.ts",
                                "!node_modules/**/.turbo/**",
                                "!node_modules/**/test/**",
                                "!node_modules/**/tests/**",
                                "!node_modules/**/tsconfig.json",
                                "!node_modules/**/*.map"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "../../apps/web/dist",
                                             "to":  "web/dist",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         }
                                     ],
                  "extraFiles":  [
                                     {
                                         "from":  "../../Tạo-Phím-Tắt-Desktop.cmd",
                                         "to":  "Tạo-Phím-Tắt-Desktop.cmd"
                                     },
                                     {
                                         "from":  "../../scripts/create-desktop-shortcut.ps1",
                                         "to":  "scripts/create-desktop-shortcut.ps1"
                                     }
                                 ],
                  "win":  {
                              "target":  [
                                             "nsis",
                                             "zip",
                                             "portable"
                                         ],
                              "icon":  "../../assets/app-icon.ico"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true
                           },
                  "portable":  {
                                   "artifactName": "OmniFlow-Studio-v${version}-windows-portable.${ext}"
                               }
              },
    "dependencies":  {
                         "@fm/browser-engine":  "workspace:*",
                         "@fm/database":  "workspace:*",
                         "@fm/file-engine":  "workspace:*",
                         "@fm/pos-adapter":  "workspace:*",
                         "@fm/sap-adapter":  "workspace:*",
                         "@fm/security":  "workspace:*",
                         "@fm/shared-types":  "workspace:*",
                         "@fm/workflow-engine":  "workspace:*",
                         "playwright":  "^1.65.0",
                         "keytar":  "^7.9.0",
                         "uuid":  "^11.0.0",
                         "date-fns":  "^4.1.0",
                         "date-fns-tz":  "^3.2.0",
                         "ws":  "^8.18.2"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "@types/uuid":  "^10.0.0",
                            "@types/ws":  "^8.18.2",
                            "electron":  "^45.3.1",
                            "typescript":  "^5.7.0",
                            "electron-builder":  "^25.0.0"
                        },
    "license":  "MIT"
}
