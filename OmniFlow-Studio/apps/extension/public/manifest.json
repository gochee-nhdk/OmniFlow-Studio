{
  "manifest_version": 3,
  "name": "OmniFlow Studio Extension",
  "version": "2.1.0",
  "description": "Tiện ích tự động hóa quy trình POS RPFO & SAP Business One 100% độc lập trên trình duyệt (Standalone).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "OmniFlow Studio — Standalone Extension v2.1"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "alarms",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "http://172.16.1.200/*",
    "*://172.16.1.210/*",
    "*://172.16.0.201/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://172.16.1.200/*",
        "*://172.16.1.200/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content/pos-autofill.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://172.16.1.210/*",
        "*://172.16.0.201/*"
      ],
      "js": ["content/sap-autofill.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ]
}
